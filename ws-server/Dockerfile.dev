FROM node:20-alpine

# 必要に応じてビルドツールを追加
RUN apk add --no-cache python3 make g++

WORKDIR /app

# 1. package.json を先にコピー
COPY ws-server/package.json ./

# 2. 未公開の自作パッケージを一時的に削除（npm install の 404 回避）
RUN node -e "const p=require('./package.json'); delete p.dependencies['@torassen/shogi-logic']; require('fs').writeFileSync('./package.json', JSON.stringify(p,null,2))"

# 3. インストール実行
RUN npm install

# 4. ソースコードをコピー（tsconfig.json を含む）
COPY ws-server/ .

# 5. 開発時はビルド済みの JS ではなく ts-node 等で動かすため、
# ここで無理に tsc を走らせず、起動コマンドに任せます
CMD ["npm", "run", "dev"]